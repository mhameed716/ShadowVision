# Models - allow small bundled efficient models in assets, ignore large ones
# Large models (>50MB) should not be committed, use download manager
# Small efficient models (<5MB) are allowed for bundled mode
**/models/*.onnx.tmp
**/models/.tmp/
# Ignore large onnx in root models/ (for offline sideload, not for git)
models/*.onnx
# Allow small efficient models in assets (force add with git add -f if needed)
# app/src/main/assets/models/*.onnx is allowed for bundled mode

